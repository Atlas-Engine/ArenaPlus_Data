package-as: ArenaPlus_Data

ignore:
  # Repository furniture the game never reads.
  - README.md
  - .git
  - .gitignore
  # Not the game's business, but not nothing either: it is what keeps the
  # pipeline's "has the ladder actually moved" check honest. It belongs in the
  # repository and not in the download.
  - .gitattributes
  - .pkgmeta

# Nothing else is ignored, and that is the whole point of this addon: every .lua
# file here is the pipeline's *output*, and an addon cannot reach the network.
# The shipped tables are the data. Ignore them and the download is an empty
# folder.
